<!-- Tiêu đề trang -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-id-card-clip text-primary me-2"></i>TIẾP NHẬN NHÂN VIÊN</h4>
    <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Về trang chủ</a>
</div>

<!-- Hộp Thông báo QĐ1 -->
<div class="qd-box shadow-sm">
    <div class="fw-bold mb-1"><i class="fa-solid fa-circle-exclamation me-1"></i>QUI ĐỊNH 1 (QĐ1):</div>
    <div>Có 6 loại bằng cấp (<em>Tú Tài, Trung Cấp, Cao Đẳng, Đại Học, Thạc Sĩ, Tiến Sĩ</em>), có 4 bộ phận (<em>Thủ Thư, Thủ Kho, Thủ Quỹ, Ban Giám Đốc</em>), có 5 chức vụ (<em>Giám Đốc, Phó Giám Đốc, Trưởng Phòng, Phó Phòng, Nhân Viên</em>).</div>
</div>

<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<!-- Khung Biểu Mẫu 1 (BM1) -->
<div class="bm-card">
    <div class="bm-header">
        <span>BM1: HỒ SƠ NHÂN VIÊN</span>
        <span class="bm-badge">Biểu mẫu chuẩn</span>
    </div>
    <div class="bm-body">
        <form action="/nhan-vien" method="POST">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Họ và tên: <span class="text-danger">*</span></label>
                    <input type="text" name="hoTen" class="form-control" placeholder="Nhập họ và tên..." required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Địa chỉ:</label>
                    <input type="text" name="diaChi" class="form-control" placeholder="Nhập địa chỉ cư trú...">
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Ngày Sinh: <span class="text-danger">*</span></label>
                    <input type="date" name="ngaySinh" class="form-control" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Điện Thoại:</label>
                    <input type="tel" name="dienThoai" class="form-control" placeholder="Số điện thoại liên hệ...">
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Bằng Cấp: <span class="text-danger">*</span></label>
                    <select name="bangCap" class="form-select" required>
                        <option value="">-- Chọn bằng cấp --</option>
                        <% danhMuc.bangCap.forEach(bc => { %>
                            <option value="<%= bc %>"><%= bc %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Bộ Phận: <span class="text-danger">*</span></label>
                    <select name="boPhan" class="form-select" required>
                        <option value="">-- Chọn bộ phận --</option>
                        <% danhMuc.boPhan.forEach(bp => { %>
                            <option value="<%= bp %>"><%= bp %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Chức vụ: <span class="text-danger">*</span></label>
                    <select name="chucVu" class="form-select" required>
                        <option value="">-- Chọn chức vụ --</option>
                        <% danhMuc.chucVu.forEach(cv => { %>
                            <option value="<%= cv %>"><%= cv %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="col-12 text-end mt-4">
                    <button type="reset" class="btn btn-secondary me-2"><i class="fa-solid fa-rotate me-1"></i>Làm lại</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Lưu Hồ Sơ Nhân Viên</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách nhân viên hiện có -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list me-2"></i>Danh Sách Nhân Viên Đã Tiếp Nhận</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và Tên</th>
                    <th>Ngày Sinh</th>
                    <th>Điện Thoại</th>
                    <th>Bằng Cấp</th>
                    <th>Bộ Phận</th>
                    <th>Chức Vụ</th>
                    <th>Địa Chỉ</th>
                </tr>
            </thead>
            <tbody>
                <% if (nhanViens && nhanViens.length > 0) { %>
                    <% nhanViens.forEach(nv => { %>
                        <tr>
                            <td><span class="badge bg-secondary">NV<%= String(nv.MaNV).padStart(3, '0') %></span></td>
                            <td class="fw-bold"><%= nv.HoTen %></td>
                            <td><%= dayjs(nv.NgaySinh).format('DD/MM/YYYY') %></td>
                            <td><%= nv.DienThoai || '---' %></td>
                            <td><span class="badge bg-info text-dark"><%= nv.BangCap %></span></td>
                            <td>
                                <% if (nv.BoPhan === 'Thủ Thư') { %>
                                    <span class="badge bg-success">Thủ Thư</span>
                                <% } else if (nv.BoPhan === 'Thủ Kho') { %>
                                    <span class="badge bg-warning text-dark">Thủ Kho</span>
                                <% } else { %>
                                    <span class="badge bg-secondary"><%= nv.BoPhan %></span>
                                <% } %>
                            </td>
                            <td><span class="fw-semibold"><%= nv.ChucVu %></span></td>
                            <td class="small text-muted"><%= nv.DiaChi || '---' %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Chưa có nhân viên nào trong hệ thống.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
