<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-book text-info me-2"></i>TIẾP NHẬN SÁCH MỚI</h4>
    <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Về trang chủ</a>
</div>

<!-- Hộp Thông báo QĐ3 -->
<div class="qd-box shadow-sm">
    <div class="fw-bold mb-1"><i class="fa-solid fa-circle-exclamation me-1"></i>QUI ĐỊNH 3 (QĐ3):</div>
    <div>Có 3 thể loại (<strong>A, B, C</strong>). Chỉ nhận các sách xuất bản <strong>trong vòng 8 năm</strong>. Người nhận sách <strong>phải là nhân viên thuộc bộ phận Thủ Kho</strong>.</div>
</div>

<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<!-- Khung Biểu Mẫu 3 (BM3) -->
<div class="bm-card">
    <div class="bm-header">
        <span>BM3: THÔNG TIN SÁCH</span>
        <span class="bm-badge">Biểu mẫu chuẩn</span>
    </div>
    <div class="bm-body">
        <form id="formSach" action="/sach" method="POST">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Tên sách: <span class="text-danger">*</span></label>
                    <input type="text" name="tenSach" class="form-control" placeholder="Nhập tên sách..." required>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Thể loại: <span class="text-danger">*</span></label>
                    <select name="theLoai" class="form-select" required>
                        <option value="">-- Chọn thể loại --</option>
                        <option value="A">Thể loại A</option>
                        <option value="B">Thể loại B</option>
                        <option value="C">Thể loại C</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Tác giả: <span class="text-danger">*</span></label>
                    <input type="text" name="tacGia" class="form-control" placeholder="Tên tác giả..." required>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Năm xuất bản: <span class="text-danger">*</span> (Trong 8 năm)</label>
                    <input type="number" id="namXuatBan" name="namXuatBan" class="form-control" placeholder="VD: 2022" min="1900" max="2099" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nhà xuất bản:</label>
                    <input type="text" name="nhaXuatBan" class="form-control" placeholder="NXB Giáo Dục, NXB Trẻ...">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Ngày nhập: <span class="text-danger">*</span></label>
                    <input type="date" id="ngayNhap" name="ngayNhap" class="form-control" value="<%= dayjs().format('YYYY-MM-DD') %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Trị giá (VNĐ): <span class="text-danger">*</span></label>
                    <input type="number" name="triGia" class="form-control" placeholder="VD: 85000" min="0" step="1000" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Người Tiếp Nhận: <span class="text-danger">*</span> (Phải là Thủ Kho)</label>
                    <select id="maNVTiepNhan" name="maNVTiepNhan" class="form-select" required>
                        <option value="">-- Chọn nhân viên tiếp nhận --</option>
                        <% nhanViens.forEach(nv => { %>
                            <option value="<%= nv.MaNV %>" data-bophan="<%= nv.BoPhan %>">
                                <%= nv.HoTen %> (<%= nv.BoPhan %> - <%= nv.ChucVu %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="col-12 text-end mt-4">
                    <button type="reset" class="btn btn-secondary me-2"><i class="fa-solid fa-rotate me-1"></i>Làm lại</button>
                    <button type="submit" class="btn btn-info text-white"><i class="fa-solid fa-plus me-1"></i>Tiếp Nhận Sách Mới</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Kho sách hiện có -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-warehouse me-2"></i>Kho Sách Thư Viện</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã Sách</th>
                    <th>Tên Sách</th>
                    <th>Thể Loại</th>
                    <th>Tác Giả</th>
                    <th>Năm XB</th>
                    <th>Nhà Xuất Bản</th>
                    <th>Trị Giá</th>
                    <th>Người Nhận (Thủ Kho)</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                <% if (sachs && sachs.length > 0) { %>
                    <% sachs.forEach(s => { %>
                        <tr>
                            <td><span class="badge bg-secondary">MS<%= String(s.MaSach).padStart(4, '0') %></span></td>
                            <td class="fw-bold"><%= s.TenSach %></td>
                            <td><span class="badge bg-primary">Loại <%= s.TheLoai %></span></td>
                            <td><%= s.TacGia %></td>
                            <td><span class="badge bg-light text-dark border"><%= s.NamXuatBan %></span></td>
                            <td class="small text-muted"><%= s.NhaXuatBan || '---' %></td>
                            <td class="fw-bold text-success"><%= Number(s.TriGia).toLocaleString('vi-VN') %> đ</td>
                            <td><span class="badge bg-light text-dark border"><%= s.TenNguoiNhan %></span></td>
                            <td>
                                <% if (s.TrangThai === 'Còn') { %>
                                    <span class="badge bg-success">Còn Sẵn</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Đang Mượn</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Chưa có sách nào trong kho.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
