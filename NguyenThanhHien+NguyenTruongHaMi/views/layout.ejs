<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Quản Lý Thư Viện - CNPM' %></title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-warning" href="/">
                <i class="fa-solid fa-book-open-reader me-2"></i>QUẢN LÝ THƯ VIỆN
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fa-solid fa-chart-pie me-1"></i> Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/nhan-vien"><i class="fa-solid fa-id-card-clip me-1"></i> BM1: Nhân Viên</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/doc-gia"><i class="fa-solid fa-address-card me-1"></i> BM2: Độc Giả</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/sach"><i class="fa-solid fa-book me-1"></i> BM3: Tiếp Nhận Sách</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/muon-sach"><i class="fa-solid fa-hand-holding-hand me-1"></i> BM4: Cho Mượn Sách</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-info" href="/tra-sach"><i class="fa-solid fa-rotate-left me-1"></i> Trả Sách</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center text-light">
                    <span class="badge bg-primary px-3 py-2"><i class="fa-solid fa-graduation-cap me-1"></i> BTL CNPM 1.1</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content container py-4">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white-50 text-center py-3 mt-auto">
        <div class="container">
            <small>Đề tài 1.1: Quản Lý Thư Viện | Học phần: Công Nghệ Phần Mềm</small>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom Validation JS -->
    <script src="/js/validation.js"></script>
</body>
</html>
